# Required: from the Nebius Token Factory dashboard (API keys)
NEBIUS_API_KEY=

# Optional: real-time web news for the Scout agent (tavily.com, free tier)
TAVILY_API_KEY=

# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Models are picked automatically from what your key can use.
# Only set these to force a specific model ID:
# NEBIUS_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_VISION_MODEL=
# PARLAY_DB=parlays.db
